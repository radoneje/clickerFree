{
  "name": "clickerfree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "db"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:locales": "npm run check -w @clickerfree/locales",
    "check": "npm run build && npm run lint && npm run typecheck && npm run check:locales && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @clickerfree/db",
    "db:migrate": "npm run build -w @clickerfree/db && npm run db:migrate -w @clickerfree/db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
